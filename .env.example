# Copie para .env (local) e para as Environment Variables do Vercel. O .env NAO vai para o git.

# --- Banco de cadastros (nome e WhatsApp) no Turso ---------------------------------------------
# Sem estas duas variaveis o jogo usa o SQLite local em data/participantes.db (bom para a feira, rodando no
# proprio computador). No Vercel elas sao OBRIGATORIAS: la nao ha disco permanente.
#   turso db show <nome-do-banco> --url      -> libsql://<banco>-<usuario>.turso.io
#   turso db tokens create <nome-do-banco>   -> token de acesso
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Servidor da feira (computador do estande): deixe RUA_BANCO_LOCAL=1 no ambiente dele para gravar no SQLite local
# mesmo com as variaveis acima preenchidas, sem depender da internet. Nao defina no Vercel.
# RUA_BANCO_LOCAL=1

# --- Assinatura da partida ---------------------------------------------------------------------
# Segredo que assina o token de cada partida. OBRIGATORIO no Vercel (varias instancias precisam do mesmo
# valor). Gere um com:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
RUA_SEGREDO=

# --- Opcionais ---------------------------------------------------------------------------------
# Endereco publico do jogo, usado no QR code da abertura (ex.: https://rua-das-palavras.vercel.app).
RUA_URL_PUBLICA=
# Palavras por etapa: o valor em vigor e o da area de gerenciamento (/admin, padrao 12); RUA_ESCOLHER so da o ponto de
# partida quando nada foi salvo la. RUA_PALAVRAS = quantas palavras entram na partida (padrao: a lista toda, 48).
# RUA_MODO=pares: valor inicial do modo das placas (duas palavras por portao); depois vale o que for salvo em /admin.
RUA_ESCOLHER=
RUA_MODO=

# --- Area de gerenciamento (/admin) ---------------------------------------------------------------
# Usuario e senha do super admin para entrar em /admin (liberar avatares, cenarios e meios, esconder minimapa e barra de progresso,
# definir palavras por etapa e editar textos). Sem os dois a area fica DESATIVADA. Defina tambem no Vercel.
# Gere uma com:  node -e "console.log(require('crypto').randomBytes(18).toString('base64url'))"
USER_AREA_ADM=
PASS_AREA_ADM=
